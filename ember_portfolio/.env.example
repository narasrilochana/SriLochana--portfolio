# Copy to .env (local) or ~/.portfolio.env (PythonAnywhere). NEVER commit the real file.

# How to send: "api" (Resend HTTPS API, works on free hosting) or "smtp" (needs unrestricted outbound access)
EMAIL_METHOD=api

# Resend API key (also the SMTP password). Create it at resend.com/api-keys with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender on YOUR VERIFIED Resend domain, e.g. portfolio@yourdomain.com
MAIL_FROM=Portfolio <portfolio@yourdomain.com>

# YOUR inbox: where notifications are delivered
MAIL_TO=you@example.com

# Optional: token to read saved messages at GET /api/messages (header X-Admin-Token)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: only if the HTML is hosted on a different domain than the API
# CORS_ORIGINS=https://your-frontend.example.com

# Optional: where SQLite lives (default: portfolio.db next to main.py)
# DATABASE_PATH=/home/Lochana07/data/portfolio.db
